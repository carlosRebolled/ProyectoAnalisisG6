@model IEnumerable<SistemaFarmaciaG6.Models.Usuario>

@{
    ViewData["Title"] = "Revisión de Informes Docentes";

    var informes = ViewBag.Informes
        as Dictionary<int, SistemaFarmaciaG6.Models.InformeDocente>;
}

<div class="container-fluid">

    <div class="categorias-section">

        <h2 class="mb-3">
            Revisión de Informes Docentes
        </h2>

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

    </div>

    <div class="row mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Buscar docente
            </label>

            <input type="text"
                   id="buscarDocente"
                   class="form-control"
                   placeholder="Escriba el nombre del docente..." />

        </div>

        <div class="col-md-4">

            <label class="form-label">
                Filtrar por estado
            </label>

            <select id="filtroEstado" class="form-select">
                <option value="">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Devuelto">Devuelto</option>
                <option value="Aprobado">Aprobado</option>
            </select>

        </div>

    </div>

    <table class="table table-hover shadow-sm categorias-table">

        <thead>
            <tr>
                <th>Docente</th>
                <th>Estado</th>
                <th>Fecha Envío</th>
                <th>Última Modificación</th>
                <th>Detalle</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var docente in Model)
            {
                var informe = informes != null && informes.ContainsKey(docente.IdUsuario)
                    ? informes[docente.IdUsuario]
                    : null;

                <tr>

                    <td>
                        @docente.Apellido1
                        @docente.Apellido2
                        @docente.Nombre
                    </td>

                    <td class="estado-informe">

                        @if (informe == null)
                        {
                            <span class="badge bg-secondary">
                                No generado
                            </span>
                        }
                        else if (informe.IdEstado == 1)
                        {
                            <span class="badge bg-secondary">
                                Borrador
                            </span>
                        }
                        else if (informe.IdEstado == 2)
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                        else if (informe.IdEstado == 3)
                        {
                            <span class="badge bg-danger">
                                Devuelto
                            </span>
                        }
                        else if (informe.IdEstado == 4)
                        {
                            <span class="badge bg-success">
                                Aprobado
                            </span>
                        }

                    </td>

                    <td>
                        @(informe?.FechaEnvio?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </td>

                    <td>
                        @(informe?.FechaCreacion.ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </td>

                    <td>
                        @if (informe != null)
                        {
                            <a asp-action="Details"
                               asp-route-id="@informe.IdInformeDocente"
                               class="btn btn-info btn-sm">
                                Ver
                            </a>

                            @if (informe.IdEstado == 2)
                            {
                                <form asp-action="Aprobar"
                                      asp-route-id="@informe.IdInformeDocente"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button class="btn btn-success btn-sm">
                                        Aprobar
                                    </button>

                                </form>

                                <a asp-action="Details"
                                   asp-route-id="@informe.IdInformeDocente"
                                   class="btn btn-warning btn-sm">
                                    Devolver
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin informe
                            </span>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        document.getElementById("buscarDocente").addEventListener("keyup", filtrarInformes);
        document.getElementById("filtroEstado").addEventListener("change", filtrarInformes);

        function filtrarInformes()
        {
            let texto = document.getElementById("buscarDocente").value.toLowerCase();
            let estado = document.getElementById("filtroEstado").value.toLowerCase();

            let filas = document.querySelectorAll(".fila-informe");

            filas.forEach(function (fila) {

                let nombre = fila.querySelector(".nombre-docente")
                                 .innerText
                                 .toLowerCase();

                let estadoFila = fila.querySelector(".estado-informe")
                                     .innerText
                                     .trim()
                                     .toLowerCase();

                let coincideNombre = nombre.includes(texto);

                let coincideEstado =
                    estado === "" ||
                    estadoFila === estado;

                fila.style.display =
                    coincideNombre && coincideEstado
                    ? ""
                    : "none";

            });
        }

    </script>

}