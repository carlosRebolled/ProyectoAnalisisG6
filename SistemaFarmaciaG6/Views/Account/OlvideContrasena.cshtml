@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Facultad Farmacia</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="icon"
          type="image/png"
          href="~/images/favicon_farmacia.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Facultad_Farmacia.styles.css"
          asp-append-version="true" />

</head>

<body>

    <div class="login-page">

        <div class="login-content">

            <!-- BARRA SUPERIOR -->

            <div class="ucr-bar">

                <a href="https://www.ucr.ac.cr"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="ucr-link">

                    UNIVERSIDAD DE COSTA RICA

                </a>

                <a href="https://farmacia.ucr.ac.cr/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="ucr-logo-link">

                    <img src="~/images/Farmacia_logo.png"
                         alt="Logo Facultad de Farmacia"
                         class="ucr-logo" />

                </a>

            </div>

            <!-- CONTENIDO -->

            <main class="login-main">

                <div class="login-wrapper">

                    <div class="card login-card">

                        <div class="login-header">

                            <div class="login-logo-container">

                                <img src="~/images/Farmacia_logo.png"
                                     alt="Logo Facultad de Farmacia"
                                     class="login-logo" />

                            </div>

                            <h1 class="login-title">
                                Recuperar contraseña
                            </h1>

                            <p class="login-subtitle">
                                Ingrese el correo registrado en su cuenta
                            </p>

                        </div>

                        <div class="card-body login-card-body">

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger">

                                    <i class="bi bi-exclamation-triangle me-2"></i>

                                    @ViewBag.Error

                                </div>
                            }

                            @if (TempData["Mensaje"] != null)
                            {
                                <div class="alert alert-info">

                                    <i class="bi bi-info-circle me-2"></i>

                                    @TempData["Mensaje"]

                                </div>
                            }

                            <form asp-controller="Account"
                                  asp-action="OlvideContrasena"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div class="mb-3">

                                    <label for="correo"
                                           class="form-label login-label">

                                        <i class="bi bi-envelope me-1"></i>
                                        Correo

                                    </label>

                                    <input type="email"
                                           id="correo"
                                           name="correo"
                                           class="form-control login-input"
                                           placeholder="Ingrese su correo"
                                           autocomplete="email"
                                           required />

                                </div>

                                <button type="submit"
                                        class="btn btn-login w-100">

                                    <i class="bi bi-send me-2"></i>
                                    Enviar código

                                </button>

                            </form>

                            <div class="text-center mt-3">

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="forgot-password-link">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Volver al inicio de sesión

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </main>

        </div>

        <!-- FOOTER -->

        <footer class="footer-custom">

            <div class="footer-content">

                <span>
                    © 2026 Facultad de Farmacia
                </span>

                <span class="footer-separator">
                    |
                </span>

                <span>
                    Tel. 2511-8350
                </span>

                <span class="footer-separator">
                    |
                </span>

                <span>
                    Correo: recepción.farmacia@ucr.ac.cr
                </span>

            </div>

        </footer>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>