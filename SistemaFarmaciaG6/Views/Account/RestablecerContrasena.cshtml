@{
    Layout = null;
    ViewData["Title"] = "Restablecer contraseña";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Facultad Farmacia</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="icon"
          type="image/png"
          href="~/images/favicon_farmacia.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Facultad_Farmacia.styles.css"
          asp-append-version="true" />

    <style>

        body {
            background: #f4f7f8;
        }

        .recovery-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .recovery-main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .recovery-card {
            width: 100%;
            max-width: 500px;
            border: none;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
        }

        .recovery-header {
            background: linear-gradient(135deg, #168f8d, #0f6f6d);
            color: white;
            text-align: center;
            padding: 30px 25px 25px;
        }

        .recovery-logo {
            max-width: 150px;
            margin-bottom: 15px;
        }

        .recovery-title {
            font-size: 1.7rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .recovery-subtitle {
            margin: 0;
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .recovery-body {
            padding: 30px;
            background: white;
        }

        .recovery-label {
            font-weight: 600;
            color: #405467;
        }

        .recovery-input {
            min-height: 46px;
            border-radius: 8px;
        }

            .recovery-input:focus {
                border-color: #168f8d;
                box-shadow: 0 0 0 0.2rem rgba(22, 143, 141, 0.15);
            }

        .password-button {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        .btn-change-password {
            background: #168f8d;
            color: white;
            border: none;
            min-height: 46px;
            border-radius: 8px;
            font-weight: 600;
            transition: 0.2s ease;
        }

            .btn-change-password:hover {
                background: #0f7472;
                color: white;
                transform: translateY(-1px);
            }

        .password-help {
            background: #f4f8f8;
            border-left: 4px solid #168f8d;
            border-radius: 6px;
            padding: 12px 14px;
            font-size: 0.88rem;
            color: #536574;
            margin-bottom: 20px;
        }

        .back-login {
            color: #168f8d;
            font-weight: 500;
            text-decoration: none;
        }

            .back-login:hover {
                color: #0f6f6d;
                text-decoration: underline;
            }

    </style>

</head>

<body>

    <div class="recovery-page">

        <!-- BARRA SUPERIOR -->

        <div class="ucr-bar">

            <a href="https://www.ucr.ac.cr"
               target="_blank"
               rel="noopener noreferrer"
               class="ucr-link">

                UNIVERSIDAD DE COSTA RICA

            </a>

            <a href="https://farmacia.ucr.ac.cr/"
               target="_blank"
               rel="noopener noreferrer"
               class="ucr-logo-link">

                <img src="~/images/Farmacia_logo.png"
                     alt="Logo Facultad de Farmacia"
                     class="ucr-logo" />

            </a>

        </div>

        <!-- CONTENIDO -->

        <main class="recovery-main">

            <div class="card recovery-card">

                <div class="recovery-header">

                    <img src="~/images/Farmacia_logo.png"
                         alt="Logo Facultad de Farmacia"
                         class="recovery-logo" />

                    <h1 class="recovery-title">
                        Nueva contraseña
                    </h1>

                    <p class="recovery-subtitle">
                        Cree una nueva contraseña para acceder a su cuenta
                    </p>

                </div>

                <div class="recovery-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger"
                             role="alert">

                            <i class="bi bi-exclamation-triangle me-2"></i>

                            @ViewBag.Error

                        </div>
                    }

                    <div class="password-help">

                        <i class="bi bi-shield-lock me-1"></i>

                        Utilice una contraseña de al menos 8 caracteres.
                        Se recomienda combinar letras, números y símbolos.

                    </div>

                    <form asp-controller="Account"
                          asp-action="RestablecerContrasena"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- NUEVA CONTRASEÑA -->

                        <div class="mb-3">

                            <label for="nuevaContrasena"
                                   class="form-label recovery-label">

                                <i class="bi bi-lock me-1"></i>
                                Nueva contraseña

                            </label>

                            <div class="input-group">

                                <input type="password"
                                       id="nuevaContrasena"
                                       name="nuevaContrasena"
                                       class="form-control recovery-input"
                                       placeholder="Ingrese su nueva contraseña"
                                       minlength="8"
                                       autocomplete="new-password"
                                       required />

                                <button type="button"
                                        class="btn btn-outline-secondary password-button"
                                        id="mostrarNueva"
                                        aria-label="Mostrar contraseña">

                                    <i id="iconoNueva"
                                       class="bi bi-eye"></i>

                                </button>

                            </div>

                        </div>

                        <!-- CONFIRMAR CONTRASEÑA -->

                        <div class="mb-4">

                            <label for="confirmarContrasena"
                                   class="form-label recovery-label">

                                <i class="bi bi-lock-fill me-1"></i>
                                Confirmar contraseña

                            </label>

                            <div class="input-group">

                                <input type="password"
                                       id="confirmarContrasena"
                                       name="confirmarContrasena"
                                       class="form-control recovery-input"
                                       placeholder="Repita su nueva contraseña"
                                       minlength="8"
                                       autocomplete="new-password"
                                       required />

                                <button type="button"
                                        class="btn btn-outline-secondary password-button"
                                        id="mostrarConfirmar"
                                        aria-label="Mostrar contraseña">

                                    <i id="iconoConfirmar"
                                       class="bi bi-eye"></i>

                                </button>

                            </div>

                        </div>

                        <!-- BOTÓN -->

                        <button type="submit"
                                class="btn btn-change-password w-100">

                            <i class="bi bi-shield-check me-2"></i>
                            Cambiar contraseña

                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="back-login">

                            <i class="bi bi-arrow-left me-1"></i>
                            Volver al inicio de sesión

                        </a>

                    </div>

                </div>

            </div>

        </main>

        <!-- FOOTER -->

        <footer class="footer-custom">

            <div class="footer-content">

                <span>
                    © 2026 Facultad de Farmacia
                </span>

                <span class="footer-separator">
                    |
                </span>

                <span>
                    Tel. 2511-8350
                </span>

                <span class="footer-separator">
                    |
                </span>

                <span>
                    Correo: recepción.farmacia@ucr.ac.cr
                </span>

            </div>

        </footer>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        // MOSTRAR / OCULTAR NUEVA CONTRASEÑA

        const botonNueva =
            document.getElementById("mostrarNueva");

        const campoNueva =
            document.getElementById("nuevaContrasena");

        const iconoNueva =
            document.getElementById("iconoNueva");

        botonNueva.addEventListener(
            "click",
            function () {

                const esPassword =
                    campoNueva.type === "password";

                campoNueva.type =
                    esPassword
                        ? "text"
                        : "password";

                iconoNueva.className =
                    esPassword
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";
            }
        );


        // MOSTRAR / OCULTAR CONFIRMACIÓN

        const botonConfirmar =
            document.getElementById("mostrarConfirmar");

        const campoConfirmar =
            document.getElementById("confirmarContrasena");

        const iconoConfirmar =
            document.getElementById("iconoConfirmar");

        botonConfirmar.addEventListener(
            "click",
            function () {

                const esPassword =
                    campoConfirmar.type === "password";

                campoConfirmar.type =
                    esPassword
                        ? "text"
                        : "password";

                iconoConfirmar.className =
                    esPassword
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";
            }
        );

    </script>

</body>

</html>